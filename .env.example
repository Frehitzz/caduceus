# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_GENERAL_CHANNEL_ID=your_general_channel_id_for_daily_digest

# Optional dedicated routing channels (if left blank, bot responds in current channel)
DISCORD_PLANS_CHANNEL_ID=
DISCORD_EXAMS_CHANNEL_ID=
DISCORD_INTERNSHIP_CHANNEL_ID=

# Single-user ID filter (optional, leave blank to allow all messages where bot has access)
ALLOWED_USER_ID=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Primary AI Provider: Groq (e.g. Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Timezone and Daily Digest Schedule (Asia/Manila by default)
TIMEZONE=Asia/Manila
DIGEST_CRON=0 8 * * *
